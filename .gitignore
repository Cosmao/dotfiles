# Secrets — never commit, even if one ends up in the repo dir
.config/zshrc/10-secrets
.claude/.credentials.json

# Claude Code: track only the actual config; everything else that may
# appear here (caches, session state, project-local settings) stays out
.claude/*
!.claude/settings.json
!.claude/CLAUDE.md

# Editor/package state that regenerates locally
.config/nvim/nvim-pack-lock.json
