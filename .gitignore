# Written by install.sh: this checkout's host, and local edits it reverted
/.host
/.adopted.patch

# Secrets — never commit, even if one ends up in the repo dir
common/.config/zshrc/10-secrets
**/.claude/.credentials.json

# Leftovers from the old single-package layout (~/.claude folded into
# the repo root) — may hold credentials and session history
/.claude/

# Claude Code: track only the actual config; everything else that may
# appear here (caches, session state, project-local settings) stays out
common/.claude/*
!common/.claude/settings.json
!common/.claude/CLAUDE.md

# Editor/package state that regenerates locally
common/.config/nvim/nvim-pack-lock.json
common/.config/nvim/lazy-lock.json

# Matugen generated outputs
**/.config/kitty/themes/Matugen.conf
**/.config/nvim/lua/matugen_palette.lua
**/.config/hypr/colors.lua
**/.config/waybar/colors.css
**/.config/dunst/dunstrc
**/.config/rofi/colors.rasi

# fish rewrites this with per-machine state
**/.config/fish/fish_variables
